source /opt/zfin/source_roots/zfin.org/commons/env/load-properties.bash

cd /opt/zfin/source_roots/zfin.org
alias nano='nano -Ynone'
# No Docker socket in these containers, so tomcat restarts through its own shutdown port
# (buildfiles/tomcat.xml). tomcatdebug has no restart policy to bring it back, so it restarts
# from the host.
alias restarttomcat='(cd /opt/zfin/source_roots/zfin.org && ant restart)'
alias restarttomcatd='echo "tomcatdebug restarts from the host: in the checkout docker/ directory, docker compose restart tomcatdebug"'


export PATH=/opt/misc/groovy/bin:$PATH
export PATH=/opt/postgres/postgresql/bin:$PATH
export PATH=/opt/ab-blast:$PATH
export PATH=$PATH:$TARGETROOT/utilities/bin

# Prompt
export PROMPT_DIRTRIM=2
export PS1="${INSTANCE}:\w\$ "

# Allow commands to fail without exiting the shell
set +e