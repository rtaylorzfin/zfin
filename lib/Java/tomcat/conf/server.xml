<?xml version="1.0" encoding="UTF-8"?>

<Server port="@SERVER-SHUTDOWN-PORT@" shutdown="SHUTDOWN">
  <Listener className="org.apache.catalina.startup.VersionLoggerListener" />
  <Listener className="org.apache.catalina.core.AprLifecycleListener" SSLEngine="on" />
  <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener" />
  <Listener className="org.apache.catalina.mbeans.GlobalResourcesLifecycleListener" />
  <Listener className="org.apache.catalina.core.ThreadLocalLeakPreventionListener" />

  <GlobalNamingResources>
    <Resource name="UserDatabase" auth="Container"
              type="org.apache.catalina.UserDatabase"
              description="User database that can be updated and saved"
              factory="org.apache.catalina.users.MemoryUserDatabaseFactory"
              pathname="conf/tomcat-users.xml" />
  </GlobalNamingResources>

  <Service name="Catalina">

    <!-- maxSwallowSize: how much of an aborted request body Tomcat will read
         and discard before closing the connection. Left at the 2 MB default,
         an upload exceeding the multipart limits in web.xml was abandoned
         mid-stream. Tomcat dropped the connection with roughly 58 MB of a
         60 MB PDF still in flight, Apache turned the broken upstream response
         into a bare "502 Bad Gateway", and Spring's 413 never reached the
         client. The uploader had no way to tell that the file was simply too
         large (ZFIN-10476).

         Set to the max-request-size declared in web.xml, deliberately, rather
         than to minus one. Any request small enough that we would have
         accepted it, including one whose single file part is over the per-file
         cap, now drains and gets a real 413 with a readable body. A request
         beyond the total request cap is still cut off, which is the right
         answer for a body we would never accept and avoids reading unbounded
         data purely to reject it.

         Keep this in step with max-request-size in home/WEB-INF/web.xml. -->
    <Connector port="@Non-SECUREPORT@" protocol="HTTP/1.1"
               connectionTimeout="20000"
               redirectPort="8443"
               maxParameterCount="1000"
               maxSwallowSize="104857600"
               />
    <Connector port="@SECUREPORT@" maxHttpHeaderSize="8192"
               proxyPort="443"
               acceptCount="200"
               maxThreads="100"
               maxParameterCount="1000"
               maxSwallowSize="104857600"
               enableLookups="false" disableUploadTimeout="true"
               SSLEnabled="true" scheme="https" secure="true"
               clientAuth="false" compression="on"
	       defaultSSLHostConfigName="zfin.org"
	       URIEncoding="UTF-8">
	       <SSLHostConfig hostName="zfin.org">
                <Certificate
                  certificateKeystoreFile="/opt/apache/apache-tomcat/conf/keystore"
                  />
               </SSLHostConfig>
      </Connector>

    <Connector protocol="AJP/1.3"
               address="::1"
               port="8009"
               redirectPort="8443"
               maxParameterCount="1000"
               secretRequired="false"
               />

    <Engine name="Catalina" defaultHost="@DOMAIN-NAME@">

      <Realm className="org.apache.catalina.realm.LockOutRealm">
        <Realm className="org.apache.catalina.realm.UserDatabaseRealm"
               resourceName="UserDatabase"/>
      </Realm>

      <Host name="@DOMAIN-NAME@"  appBase="webapps"
            unpackWARs="false" autoDeploy="false">

        <!-- Honour the proxy headers httpd (and anything in front of it) already sends.
             Without this, request.getScheme() and getRemoteAddr() report the LAST hop: httpd
             proxies /action/ to http://tomcat:2008 from its :80 vhost, so every absolute URL
             the app builds from request.getRequestURL() comes out http. JSESSIONID is Secure,
             so a browser then drops the session on the next request. That is how solving a
             captcha used to redirect straight back to the challenge, forever.
             internalProxies covers the RFC1918 ranges Docker bridges live on, so only a
             neighbouring container can set these headers; a real client cannot forge them. -->
        <Valve className="org.apache.catalina.valves.RemoteIpValve"
               remoteIpHeader="x-forwarded-for"
               protocolHeader="x-forwarded-proto"
               protocolHeaderHttpsValue="https"
               internalProxies="10\.\d{1,3}\.\d{1,3}\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}|169\.254\.\d{1,3}\.\d{1,3}|127\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.1[6-9]\.\d{1,3}\.\d{1,3}|172\.2[0-9]\.\d{1,3}\.\d{1,3}|172\.3[0-1]\.\d{1,3}\.\d{1,3}" />

        <Valve className="org.apache.catalina.valves.AccessLogValve" directory="logs"
               prefix="localhost_access_log" suffix=".txt"
               pattern="%h %l %u %t &quot;%r&quot; %s %b" />

      </Host>
    </Engine>
  </Service>
</Server>
